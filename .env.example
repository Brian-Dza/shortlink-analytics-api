# Application
APP_NAME=shortlink-analytics-api
APP_ENV=development
DEBUG=false
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# PostgreSQL (Docker Compose & AsyncPG)
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=shortlink_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shortlink:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/shortlink_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://redis:6379/0
LINK_CACHE_TTL_SECONDS=86400

# Security (generate real secrets before running in production)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
IP_HASH_SALT=CHANGE_ME_GENERATE_RANDOM_SALT

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANON_MAX_REQUESTS=10
RATE_LIMIT_AUTH_MAX_REQUESTS=30
